{
  "cli": {
    "version": ">= 16.15.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development",
        "APP_ENV": "development",
        "EXPO_PUBLIC_APP_MODE": "demo",
        "EXPO_PUBLIC_HEIA_PROVIDER": "mock"
      }
    },
    "investor-apk": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "investor-demo",
      "env": {
        "APP_VARIANT": "production",
        "APP_ENV": "production",
        "APP_VERSION": "1.0.0",
        "ANDROID_VERSION_CODE": "1",
        "EXPO_PUBLIC_APP_MODE": "demo",
        "EXPO_PUBLIC_HEIA_PROVIDER": "real",
        "EXPO_PUBLIC_HAYA_API_URL": "https://haya-trips-api.onrender.com"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
