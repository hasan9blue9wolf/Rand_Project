# Public Expo variables are bundled into the client app.
# Never put service-role keys, private tokens, or provider secrets in EXPO_PUBLIC_* values.
APP_VARIANT=development
APP_ENV=development
APP_VERSION=1.0.0
IOS_BUILD_NUMBER=1
ANDROID_VERSION_CODE=1
EXPO_PUBLIC_APP_MODE=demo
EXPO_PUBLIC_API_BASE_URL=https://api.hayatrips.app
EXPO_PUBLIC_HAYA_API_URL=
EXPO_PUBLIC_EAS_UPDATE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_HEIA_PROVIDER=mock
